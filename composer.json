{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "katala/fire-protection-workspace",
    "type": "project",
    "description": "Workspace wrapper for the Katala Fire Protection website and Laravel backend.",
    "license": "MIT",
    "scripts": {
        "backend:install": "composer install --working-dir=backend",
        "backend:update": "composer update --working-dir=backend",
        "backend:test": "composer test --working-dir=backend",
        "backend:dev": "composer dev --working-dir=backend"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4"
    }
}
